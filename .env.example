# ==============================================================================
# Fintrack — Environment Configuration Template
# Copy this file to `.env.local` or `.env` and supply your actual credentials.
# NEVER commit `.env` or files with real secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# ------------------------------------------------------------------------------
# PostgreSQL Database Connections (Prisma ORM)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL:
#    The pooled connection URL used by the application runtime (App Router).
#    If using Supabase or Neon with PgBouncer/Supavisor, append `?pgbouncer=true`.
#    Example (Local):   postgresql://postgres:password@localhost:5432/fintrack?schema=public
#    Example (Pooled):  postgresql://user:password@ep-xyz-pooler.region.neon.tech/fintrack?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/fintrack?schema=public"

# 2. DIRECT_URL:
#    The unpooled direct connection URL required by Prisma CLI for migrations and introspection.
#    Example (Local):   postgresql://postgres:password@localhost:5432/fintrack?schema=public
#    Example (Direct):  postgresql://user:password@ep-xyz.region.neon.tech/fintrack?sslmode=require
DIRECT_URL="postgresql://postgres:password@localhost:5432/fintrack?schema=public"

# ------------------------------------------------------------------------------
# Application Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

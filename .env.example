# ==============================================================================
# Fintrack — Environment Configuration Template
# Copy this file to `.env.local` or `.env` and supply your actual credentials.
# NEVER commit `.env` or files with real secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# ------------------------------------------------------------------------------
# MongoDB Database Connection (Mongoose ODM)
# ------------------------------------------------------------------------------
# MONGODB_URI:
#   The MongoDB connection string used by the Mongoose connection singleton.
#   Example (Local):   mongodb://localhost:27017/fintrack
#   Example (Atlas):   mongodb+srv://<username>:<password>@cluster0.mongodb.net/fintrack?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/fintrack"

# ------------------------------------------------------------------------------
# Application Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
